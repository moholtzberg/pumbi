DATABASE_URL=postgresql://user:password@host/database?sslmode=require
AUTH_SECRET=replace-with-a-long-random-value
CRON_SECRET=replace-with-a-separate-long-random-value
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# SMTP2GO transactional email (server-only; sender must be verified in SMTP2GO)
SMTP2GO_API_KEY=
SMTP2GO_FROM_EMAIL=Pumbi <hello@ginzeyamerica.com>
# Canonical public origin for password-reset links, e.g. https://your-domain.com
APP_URL=http://localhost:5173

# LiveKit Cloud (auctioneer camera/microphone and automatic viewer playback)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shippo (shipping rates, labels, tracking webhooks)
SHIPPO_API_TOKEN=
# Optional shared secret for /api/webhooks/shippo (?token= or x-shippo-token header)
SHIPPO_WEBHOOK_TOKEN=
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_VERIFY_SERVICE_SID=VA_replace_me

# Optional integrations
STORAGE_PROVIDER=s3

# DigitalOcean Spaces (S3-compatible storage)
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=pumbi-storage
AWS_REGION=nyc3
