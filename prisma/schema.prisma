enum AuctionHouseDocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model AuctionHouseDocument {
  id             String                           @id @default(cuid())
  auctionHouseId String                           @map("auction_house_id")
  type           AuctionHouseDocumentType
  cloudKey       String                           @map("cloud_key")
  privateUrl     String?                          @map("private_url")
  fileName       String?                          @map("file_name")
  mimeType       String                           @map("mime_type")
  sizeBytes      Int                              @map("size_bytes")
  licenseNumber  String?                          @map("license_number")
  jurisdiction   String?
  expiresAt      DateTime?                        @map("expires_at")
  reviewStatus   AuctionHouseDocumentReviewStatus @default(PENDING) @map("review_status")
  reviewedById   String?                          @map("reviewed_by_id")
  reviewedAt     DateTime?                        @map("reviewed_at")
  reviewNotes    String?                          @map("review_notes")
  createdAt      DateTime                         @default(now()) @map("created_at")
  updatedAt      DateTime                         @updatedAt @map("updated_at")

  auctionHouse AuctionHouse @relation(fields: [auctionHouseId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("AuctionHouseDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([auctionHouseId])
  @@index([type])
  @@index([reviewStatus])
  @@index([reviewedById])
