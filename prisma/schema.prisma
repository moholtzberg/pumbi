enum AuctionHouseLocationType {
  HEADQUARTERS
  OFFICE
  WAREHOUSE
  SHOWROOM
  OTHER
}

model AuctionHouseLocation {
  id             String                   @id @default(cuid())
  auctionHouseId String                   @map("auction_house_id")
  name           String?
  type           AuctionHouseLocationType @default(OTHER)
  isPrimary      Boolean                  @default(false) @map("is_primary")
  addressLine1   String                   @map("address_line_1")
  addressLine2   String?                  @map("address_line_2")
  city           String
  stateProvince  String?                  @map("state_province")
  postalCode     String?                  @map("postal_code")
  country        String
  contactName    String?                  @map("contact_name")
  contactEmail   String?                  @map("contact_email")
  contactPhone   String?                  @map("contact_phone")
  businessHours  Json?                    @map("business_hours")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  auctionHouse AuctionHouse @relation(fields: [auctionHouseId], references: [id], onDelete: Cascade)

  @@index([auctionHouseId])
  @@index([auctionHouseId, isPrimary])
  @@map("auction_house_locations")
}

enum AuctionHouseDocumentType {
  BUSINESS_LICENSE
  TAX_DOCUMENT
