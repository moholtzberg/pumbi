enum AuctionHouseMembershipRole {
  OWNER
  ADMIN
  AUCTION_MANAGER
  CATALOG_MANAGER
  FINANCE
  VIEWER
}

enum AuctionHouseMembershipStatus {
  ACTIVE
  SUSPENDED
}

model AuctionHouseMembership {
  id             String                       @id @default(cuid())
  auctionHouseId String                       @map("auction_house_id")
  userId         String                       @map("user_id")
  role           AuctionHouseMembershipRole   @default(VIEWER)
  status         AuctionHouseMembershipStatus @default(ACTIVE)
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  auctionHouse AuctionHouse @relation(fields: [auctionHouseId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, auctionHouseId])
  @@index([auctionHouseId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@map("auction_house_memberships")
