enum AuctionHouseInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model AuctionHouseInvitation {
  id             String                       @id @default(cuid())
  auctionHouseId String                       @map("auction_house_id")
  email          String
  firstName      String?                      @map("first_name")
  lastName       String?                      @map("last_name")
  role           AuctionHouseMembershipRole
  tokenHash      String                       @unique @map("token_hash") @db.Char(64)
  status         AuctionHouseInvitationStatus @default(PENDING)
  invitedById    String                       @map("invited_by_id")
  expiresAt      DateTime                     @map("expires_at")
  acceptedAt     DateTime?                    @map("accepted_at")
  acceptedById   String?                      @map("accepted_by_id")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  auctionHouse AuctionHouse @relation(fields: [auctionHouseId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("AuctionHouseInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("AuctionHouseInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([auctionHouseId])
  @@index([email])
  @@index([status])
  @@index([invitedById])
  @@index([acceptedById])
  @@index([expiresAt])
  @@map("auction_house_invitations")
}

enum PayoutReleaseStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
  CANCELLED
}

model PayoutRelease {
  id                   String              @id @default(cuid())
  auctionHouseId       String              @map("auction_house_id")
  amount               Decimal             @db.Decimal(14, 2)
  currency             String
  sourceReference      String              @map("source_reference")
  reason               String
  status               PayoutReleaseStatus @default(REQUESTED)
  requestedById        String              @map("requested_by_id")
  requestedAt          DateTime            @default(now()) @map("requested_at")
  approvedById         String?             @map("approved_by_id")
  approvedAt           DateTime?           @map("approved_at")
  rejectedAt           DateTime?           @map("rejected_at")
  processedAt          DateTime?           @map("processed_at")
  paidAt               DateTime?           @map("paid_at")
  stripeTransferId     String?             @unique @map("stripe_transfer_id")
  stripeError          String?             @map("stripe_error")
  stripeIdempotencyKey String?             @unique @map("stripe_idempotency_key")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  auctionHouse AuctionHouse @relation(fields: [auctionHouseId], references: [id], onDelete: Restrict)
  requestedBy  User         @relation("PayoutReleaseRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("PayoutReleaseApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([auctionHouseId, sourceReference])
  @@index([auctionHouseId])
  @@index([status])
  @@index([requestedById])
  @@index([approvedById])
  @@index([sourceReference])
  @@map("payout_releases")
}
