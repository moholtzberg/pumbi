generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// AuctionHouse model - represents a multi-tenant auction house organization
model AuctionHouse {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // URL-friendly identifier (e.g., "heritage-judaica")
  domain      String?  @unique // Custom domain (optional)
  description String?
  logoUrl     String?  @map("logo_url")
  settings    String?  // JSON string for custom settings
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users    User[]    // Users belonging to this auction house (sellers, auctioneers)
  auctions Auction[] // Auctions hosted by this auction house

  @@index([slug])
  @@index([isActive])
  @@map("auction_houses")
}

// User model - represents users in the system
model User {
  id            String       @id @default(cuid())
  email         String       @unique
  password      String?      // Hashed password (optional for existing users, required for new)
  name          String?
  firstName     String?      @map("first_name")
  lastName      String?      @map("last_name")
  phone         String?      // Phone number
  address       String?      // Address
  isVerifiedBuyer Boolean    @default(false) @map("is_verified_buyer") // Profile verified
  isVerifiedBidder Boolean   @default(false) @map("is_verified_bidder") // Can bid as verified bidder
  resetPasswordToken String? @map("reset_password_token") // Token for password reset
  resetPasswordExpires DateTime? @map("reset_password_expires") // Expiration for reset token
  role          UserRole     @default(BUYER)
  auctionHouseId String?     @map("auction_house_id") // For sellers/auctioneers
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  auctionHouse AuctionHouse? @relation(fields: [auctionHouseId], references: [id], onDelete: SetNull)
  auctions     Auction[]     // Auctions created by this user (if seller)
  bids         Bid[]
  auctionRegistrations AuctionRegistration[] // Auctions this user registered for

  @@index([auctionHouseId])
  @@index([role])
  @@index([isVerifiedBuyer])
  @@index([isVerifiedBidder])
  @@index([email])
  @@map("users")
}

enum UserRole {
  BUYER
  SELLER
  AUCTIONEER
}

// Auction model - represents an auction event
model Auction {
  id            String        @id @default(cuid())
  title         String
  description   String?
  startDate     DateTime      @map("start_date")
  endDate       DateTime      @map("end_date")
  status        AuctionStatus  @default(UPCOMING)
  imageUrl      String?       @map("image_url")
  settings      String?       // JSON string for auction-specific settings
  auctionHouseId String       @map("auction_house_id") // Multi-tenant: which auction house hosts this
  sellerId      String        @map("seller_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  auctionHouse AuctionHouse @relation(fields: [auctionHouseId], references: [id], onDelete: Cascade)
  seller       User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  lots         Lot[]
  registrations AuctionRegistration[] // Users registered for this auction

  @@index([auctionHouseId])
  @@index([sellerId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("auctions")
}

enum AuctionStatus {
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

// Lot model - represents an individual lot/item in an auction
model Lot {
  id                String     @id @default(cuid())
  auctionId         String     @map("auction_id")
  lotNumber         Int        @map("lot_number")
  position          Int        @default(0) // Order/position for displaying lots (1, 2, 3, ...)
  title             String
  hebrewTitle       String?    @map("hebrew_title")
  description       String?
  hebrewDescription String?   @map("hebrew_description")
  category          String?
  tags              String?    // JSON array of tags
  metaFields        String?    @map("meta_fields") // JSON object for category-specific metadata
  startingBid       Float      @map("starting_bid")
  currentBid        Float      @default(0) @map("current_bid")
  bidIncrement      Float      @map("bid_increment")
  status            LotStatus  @default(ACTIVE)
  endTime           DateTime?  @map("end_time")
  highestBidderId   String?    @map("highest_bidder_id")
  highestBidderName String?    @map("highest_bidder_name")
  isReady           Boolean    @default(false) @map("is_ready")
  watchersCount     Int        @default(0) @map("watchers_count")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  // Relations
  auction Auction     @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bids    Bid[]
  images  LotImage[]  // Multiple images per lot
  notes   LotNote[]   // Notes associated with this lot

  @@unique([auctionId, lotNumber])
  @@index([auctionId])
  @@index([status])
  @@index([endTime])
  @@index([position])
  @@map("lots")
}

// LotImage model - represents images associated with a lot
model LotImage {
  id          String   @id @default(cuid())
  lotId       String   @map("lot_id")
  url         String   // Cloud storage URL
  cloudKey    String?  @map("cloud_key") // Key/identifier in cloud storage
  displayOrder Int     @default(0) @map("display_order") // Order for displaying images
  isPrimary   Boolean  @default(false) @map("is_primary") // Primary/thumbnail image
  isHidden    Boolean  @default(false) @map("is_hidden") // Hide image from public display
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([displayOrder])
  @@index([isPrimary])
  @@index([isHidden])
  @@map("lot_images")
}

enum LotStatus {
  ACTIVE
  SOLD
  UNSOLD
  WITHDRAWN
}

// Bid model - represents a bid placed on a lot
model Bid {
  id        String   @id @default(cuid())
  lotId     String   @map("lot_id")
  userId    String   @map("user_id")
  userName  String?  @map("user_name")
  amount    Float
  timestamp DateTime @default(now())

  // Relations
  lot  Lot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([userId])
  @@index([timestamp])
  @@map("bids")
}

// LotNote model - represents notes (voice or text) associated with a lot
model LotNote {
  id              String   @id @default(cuid())
  lotId           String   @map("lot_id")
  content         String?  // Transcribed or text note content
  summary         String?  // AI-generated summary
  audioUrl        String?  @map("audio_url") // URL to uploaded audio file
  transcription   String?  // Raw transcription from speech-to-text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([createdAt])
  @@map("lot_notes")
}

// AuctionRegistration model - tracks which users registered for which auctions
model AuctionRegistration {
  id        String   @id @default(cuid())
  auctionId String   @map("auction_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([auctionId, userId])
  @@index([auctionId])
  @@index([userId])
  @@map("auction_registrations")
}
